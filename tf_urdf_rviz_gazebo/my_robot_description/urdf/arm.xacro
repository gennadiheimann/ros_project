<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="arm_base_length" value="0.1" />
    <xacro:property name="arm_base_width" value="0.1" />
    <xacro:property name="arm_base_height" value="0.02" />
    <!-- <xacro:property name="wheel_radius" value="0.1" /> -->
    <!-- <xacro:property name="wheel_length" value="0.05" /> -->

    <link name="arm_base_link">
        <visual>
            <geometry>
                <box size="${arm_base_length} ${arm_base_width} ${arm_base_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="green" />
        </visual>

        <collision>
            <geometry>
                <box size="${arm_base_length} ${arm_base_width} ${arm_base_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>

        <!-- <xacro:box_inertia m="5.0" x="${base_length}" y="${base_width}" z="${base_height}" 
                       o_xyz="0 0 ${base_height / 2.0}" o_rpy="0 0 0" /> -->
    </link>


</robot>